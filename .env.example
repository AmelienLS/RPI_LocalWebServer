# ==============================================================================
# Fichier de configuration d'environnement — TEMPLATE (versionné)
#
# Copier ce fichier et le renommer en ".env" pour l'activer.
# Les valeurs ci-dessous sont les valeurs par défaut de l'application.
# Les variables non définies (commentées) utilisent leur valeur par défaut.
#
# IMPORTANT : Ne jamais versionner le fichier ".env" — il peut contenir
# des secrets (clé Flask, chemins sensibles). Seul ".env.example" est versionné.
# ==============================================================================


# ------------------------------------------------------------------------------
# CHEMINS & RÉPERTOIRES
# ------------------------------------------------------------------------------

# Répertoire d'instance (contient config.ini et la base de données par défaut)
# Valeur par défaut : <racine_projet>/instance
#APP_INSTANCE_DIR=/chemin/absolu/vers/instance

# Chemin vers la base de données SQLite
# Priorité : cette variable > config.ini > APP_INSTANCE_DIR/armoire.db
# Valeur par défaut : APP_INSTANCE_DIR/armoire.db
#DATABASE_PATH=/chemin/absolu/vers/armoire.db

# Répertoire des logs CSV journaliers (format JJ-MM-AAAA.csv)
# Valeur par défaut : APP_INSTANCE_DIR/logs
#APP_LOGS_DIR=/chemin/absolu/vers/logs


# ------------------------------------------------------------------------------
# SERVEUR
# ------------------------------------------------------------------------------

# Adresse d'écoute du serveur Flask
# Valeur par défaut : 127.0.0.1 (local uniquement)
# Mettre 0.0.0.0 pour écouter sur toutes les interfaces réseau (accès LAN/RPI)
#APP_HOST=127.0.0.1

# Port d'écoute du serveur Flask
# Valeur par défaut : 5000
#APP_PORT=5000

# Mode debug Flask (affiche les erreurs détaillées, rechargement automatique)
# Valeur par défaut : 0 — NE JAMAIS activer en production
# Valeurs acceptées : 1, true, yes, on / 0, false, no, off
#FLASK_DEBUG=0

# Clé secrète pour la signature des sessions Flask
# Valeur par défaut : clé aléatoire générée à chaque démarrage (sessions perdues au restart)
# Définir une clé fixe pour conserver les sessions entre redémarrages
#FLASK_SECRET_KEY=python -c "import secrets; print(secrets.token_hex(32))"


# ------------------------------------------------------------------------------
# NAVIGATEUR
# ------------------------------------------------------------------------------

# Ouvrir automatiquement le navigateur au démarrage
# Valeur par défaut : 0 (désactivé)
# Valeurs acceptées : 1, true, yes, on / 0, false, no, off
#APP_AUTO_OPEN_BROWSER=0

# URL à ouvrir dans le navigateur au démarrage
# Valeur par défaut : http://127.0.0.1:<APP_PORT>/
#APP_BROWSER_URL=http://127.0.0.1:5000/

# Commande personnalisée pour ouvrir le navigateur (ex: chromium-browser, firefox)
# Valeur par défaut : navigateur système par défaut
#APP_BROWSER_CMD=
