# ==============================================================================
# Environnement : DÉVELOPPEMENT LOCAL
#
# Copier ce fichier en ".env" pour activer la configuration de développement.
#   cp .env.development .env
#
# Ce fichier n'est PAS versionné.
# ==============================================================================

# --- Chemins ---
# Utilise le dossier instance/ local (valeur par défaut, peut être omis)
# APP_INSTANCE_DIR=

# --- Serveur ---
APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=1

# --- Session ---
# Clé fixe pour garder la session entre redémarrages en dev
FLASK_SECRET_KEY=python -c "import secrets; print(secrets.token_hex(32))"

# --- Navigateur ---
APP_AUTO_OPEN_BROWSER=1
APP_BROWSER_URL=http://127.0.0.1:5000/
